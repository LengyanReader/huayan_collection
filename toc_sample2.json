[{"no": 1, "vol": "035", "start_folio": "1b.1", "tibetan_open": "།རྒྱ་གར་སྐད་དུ། བུདྡྷ་ཨ་བ་ཏང་ས་ཀ་ནཱ་མ་མ་ཧཱ་བཻ་པུ་ལྱཾ་སཱུ་ཏྲ། བོད་སྐད་དུ། སངས་རྒྱས་ཕལ་པོ་ཆེ", "alignment_status": "待核"}, {"no": 2, "vol": "035", "start_folio": "65a.2", "tibetan_open": "དེ་ནས་བྱང་ཆུབ་སེམས་དཔའ་དེ་དག་དང་། འཇིག་རྟེན་གྱི་དབང་པོ་དེ་དག་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ། ས", "alignment_status": "待核"}]