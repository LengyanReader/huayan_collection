{"vs": [{"n": "藏文德格版 (Toh 44)", "c": 45, "v": "4册", "t": "胜友、智军", "p": "9世纪初"}, {"n": "汉文八十华严 (T10n0279)", "c": 39, "v": "80卷", "t": "实叉难陀", "p": "699年"}, {"n": "汉文六十华严 (T09n0278)", "c": 34, "v": "60卷", "t": "佛驮跋陀罗", "p": "420年"}, {"n": "汉文四十华严 (T10n0293)", "c": 1, "v": "40卷", "t": "般若", "p": "798年"}], "sm": {"A": 2, "B": 3, "C": 3, "D": 1, "E": 32}, "cs": [{"bo": 7, "z80": 7, "ti": "如来名号品", "sa": "", "tp": "C", "sm": "藏文此品位于《如来华严品》之后，故品目序号从汉文第7品变为藏文第12品。内容基本对应但结构位置不同。"}, {"bo": 11, "z80": null, "ti": "如来华严品", "sa": "Tathāgatāvataṃsaka", "tp": "A", "sm": "藏文独有品目。汉文六十华严、八十华严、四十华严均无此品。"}, {"bo": 27, "z80": 26, "ti": "十地品", "sa": "", "tp": "B", "sm": "藏文十地品可能源自更完整的梵本，结构接近独立《十地经》(Daśabhūmika)。与汉文十地品在细节上有参差。"}, {"bo": 28, "z80": null, "ti": "普贤宣说品", "sa": "Samantabhadraparivarta", "tp": "A", "sm": "藏文独有品目。汉文六十华严、八十华严、四十华严均无此品。"}, {"bo": 33, "z80": 31, "ti": "寿量品", "sa": "", "tp": "B", "sm": "藏文可能有更详尽的诸佛寿量描述。"}, {"bo": 39, "z80": 37, "ti": "如来出现品", "sa": "", "tp": "C", "sm": "六十华严无此品（仅34品）。八十华严对应《如来出现品》，六十华严对应第33品《宝王如来性起品》，名称和结构均有不同。"}, {"bo": 40, "z80": 38, "ti": "离世间品", "sa": "", "tp": "B", "sm": "藏文此品有部分独特异译段落，与汉文同名品内容有实质性参差。"}, {"bo": 41, "z80": 39, "ti": "入法界品", "sa": "Gaṇḍavyūha", "tp": "C", "sm": "四十华严即此品全本。藏文《入法界品》为全本。六十华严缺此品（仅有34品）。汉文有多个别译本。"}], "wn": ["⚠ T0309 法藏判为非十住品亦非十地品"]}