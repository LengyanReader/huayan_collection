    "dkarchag": {
      "source": "data/references/tibetan/derge_tengyur/vol213_dkarchag.txt",
      "sha256": "c708b84751f755128d8f68efc031fd66bdaaefc9ce24bd890f95c39aa5bd8675",
      "entries": [
        {
          "kw": "བཟང་པོ་སྤྱོད་པ",
          "topic": "行愿讚释",
          "folio": "443b.2",
          "text": "བ་དགེ་སློང་ཚུལ་ཁྲིམས་རྒྱལ་བའི་འགྱུར། འཕགས་  པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོ་ཆེན་པོའི་བཤད་སྦྱར་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པ། ཁ་ཆེའི་མཁན་པོ་ཐིག་ལེ་བུམ་པ་དང༌། སྒྲ་སྒྱུར་གྱི་ལོ་ཙཱ་བ་དགེ་སློང་བློ་ལྡན་ཤེས་རབ་ཀྱི་འགྱུར། ཀུན་དུ་བཟང་པོའི་སྤྱོད་པའི་སྨོན་ལམ་གྱི་དོན་ཀུན་བསྡུས་ཏེ་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོས་མཛད་པ།  འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོའི་རྒ"
        },
        {
          "kw": "བཟང་པོ་སྤྱོད་པ",
          "topic": "行愿讚释",
          "folio": "443b.3",
          "text": "བསྡུས་ཏེ་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོས་མཛད་པ།  འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོའི་རྒྱ་ཆེར་འགྲེལ་པ་སློབ་དཔོན་ཤཱཀྱའི་བཤེས་གཉེན་གྱིས་མཛད་པ། རྒྱ་གར་གྱི་མཁན་པོ་ཤཱཀྱ་སིངྷ་དང༌། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་དཔལ་བརྩེགས་ཀྱི་འགྱུར། འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོའི་རྒྱ་ཆེར་འགྲེལ་པ་སློབ་དཔོན་ རྒྱན་བཟང་པོས་མཛད་པ། རྒྱ་གར་གྱི་མཁན་པོ་ཛྙཱ་ན་གརྦྷ་དང༌། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་"
        },
        {
          "kw": "བཟང་པོ་སྤྱོད་པ",
          "topic": "行愿讚释",
          "folio": "443b.3",
          "text": "ྱ་སིངྷ་དང༌། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་དཔལ་བརྩེགས་ཀྱི་འགྱུར། འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོའི་རྒྱ་ཆེར་འགྲེལ་པ་སློབ་དཔོན་ རྒྱན་བཟང་པོས་མཛད་པ། རྒྱ་གར་གྱི་མཁན་པོ་ཛྙཱ་ན་གརྦྷ་དང༌། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བནྡེ་སྐ་བ་དཔལ་བརྩེགས་ཀྱི་འགྱུར། འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་འགྲེལ་པ་སློབ་དཔོན་དབྱིག་གཉེན་གྱིས་མཛད་པ། རྒྱ་གར་གྱི་མཁན་པོ་པཎྜི་ཏ་ཨཱ་ཙཱརྱ་ཨཱ་ནནྡ་དང༌། ལོ་ཙཱ་བ་དགེ་སློང་བྷ"
        },
        {
          "kw": "བཟང་པོ་སྤྱོད་པ",
          "topic": "行愿讚释",
          "folio": "443b.4",
          "text": "། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བནྡེ་སྐ་བ་དཔལ་བརྩེགས་ཀྱི་འགྱུར། འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་འགྲེལ་པ་སློབ་དཔོན་དབྱིག་གཉེན་གྱིས་མཛད་པ། རྒྱ་གར་གྱི་མཁན་པོ་པཎྜི་ཏ་ཨཱ་ཙཱརྱ་ཨཱ་ནནྡ་དང༌། ལོ་ཙཱ་བ་དགེ་སློང་བྷ་དྲ་པཱ་ ལའི་འགྱུར་བ་རྣམས་བཞུགས་སོ།། །།ཏི་ཐི་དི་གསུམ་ལ། འཕགས་པ་དགོངས་པ་ཟབ་མོ་ངེས་པར་འགྲེལ་པའི་མདོའི་རྒྱ་ཆེར་འགྲེལ་པ་རྒྱའི་སློབ་དཔོན་མཁན་པོ་ཝེན་ཚེག་གིས་མཛད་པ། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་འག"
        }
      ]
    }
  },
