  "quotes": {
    "q_yb_carry": {
      "source": "songgao",
      "lb": "0895b08",
      "text": "遇心王菩薩指示支提山靈府，遂負《華嚴經》八十卷，尋訪霍童，禮天冠菩薩，至支提石室而宅焉。"
    },
    "q_yb_hide": {
      "source": "songgao",
      "lb": "0895b15",
      "text": "于時屬會昌搜毀，表將經以華櫚木函盛，深藏石室中。殆宣宗大中元年丙寅，保福慧評禪師素聞往事，躬率信士迎出甘露都尉院，其紙墨如新繕寫，今貯在福州僧寺焉。"
    },
    "q_zhi_chant": {
      "source": "songgao",
      "lb": "0881b29",
      "text": "年十五，誦《法華》、《華嚴》、《維摩》等經。"
    },
    "q_zhi_hide": {
      "source": "songgao",
      "lb": "0881c05",
      "text": "後往永嘉，鍾會昌之搜簡，乃隱樂成縣大芙蓉山，胎息而已。"
    },
    "q_lifa_hui": {
      "source": "songgao",
      "lb": "0888b08",
      "text": "至乎會昌年內，玄暢大師請修加《一萬五千佛名經》，是以兩京禮經，則口唱低頭，檛磬一聲，謂之「小禮」。"
    },
    "q_lifa_zhu": {
      "source": "songgao",
      "lb": "0888b13",
      "text": "又有斆古人逐字禮《華嚴》、《法華》經，以為禮無漏法藏也。"
    },
    "q_ta_hui": {
      "source": "songgao",
      "lb": "0797a06",
      "text": "其塔屬會昌中，例皆毀焉。"
    },
    "q_zongmi": {
      "source": "songgao",
      "lb": "0742a12",
      "text": "會昌元年正月六日坐滅於興福塔院，儼若平日，容貌益悅。"
    },
    "q_zhou_xiang": {
      "source": "guanghong",
      "lb": "0203a04",
      "text": "襄州峴山華嚴寺盧舍那瑞像者。本是周朝古像。法滅藏之得存。"
    },
    "q_hf_pei": {
      "source": "hufa",
      "lb": "0639c26",
      "text": "故唐相裴公美序華嚴法界觀云。世尊初成正覺。歎曰。奇哉一切眾生。具有如來智慧德相。但以妄想執著。而不證得。於是稱法界性。說華嚴經。"
    },
    "q_hf_fashen": {
      "source": "hufa",
      "lb": "0641a28",
      "text": "華嚴亦云。佛以法為身。清淨如虛空。"
    },
    "q_hf_sun": {
      "source": "hufa",
      "lb": "0645b02",
      "text": "孫思邈寫華嚴經。又請僧誦法華經。呂洞賓參禪設供。彼神仙也"
    },
    "q_tj_yuan1": {
      "source": "tanjin",
      "lb": "0654b12",
      "text": "始余為原教。師華嚴經先列乎菩薩乘。蓋取其所謂依本起末門者也。"
    },
    "q_tj_yuan2": {
      "source": "tanjin",
      "lb": "0654b15",
      "text": "今書乃先列乎人天乘。亦從華嚴之所謂攝末歸本門者也。"
    }
  },
