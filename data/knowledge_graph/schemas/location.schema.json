{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huayan-collection.org/schemas/location.schema.json",
  "title": "华严宗道场/地点数据模型",
  "type": "object",
  "required": ["version", "locations"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "last_updated": { "type": "string", "format": "date" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_zh", "lat", "lng", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^loc_\\d{3}$" },
          "name_zh": { "type": "string" },
          "current_name": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 },
          "type": {
            "type": "string",
            "enum": ["temple", "mountain", "region", "city", "translation_site"]
          },
          "dynasty": { "type": "string" },
          "city": { "type": "string" },
          "province": { "type": "string" },
          "description": { "type": "string" },
          "related_persons": {
            "type": "array",
            "items": { "type": "string", "pattern": "^person_\\d{3}$" }
          },
          "source": { "type": "string" }
        }
      }
    }
  }
}
