, "lat": 39.0306, "lng": 113.5648, "tp": "mountain", "dy": "唐", "ds": "文殊菩萨道场，华严经中明指为清凉山。澄观（清凉国师）曾于此著《华严经疏》，'清凉'之号由此而来。华严宗与五台山渊源极深。唐代大华严寺为山中核心华严道场。", "ps": ["person_004"]}, {"id": "loc_004", "n": "圭峰", "lat": 34.03, "lng": 108.68, "tp": "mountain", "dy": "唐", "ds": "宗密晚年住此，世称圭峰大师。", "ps": ["person_005"]}, {"id": "loc_005", "n": "方山", "lat": 38.04, "lng": 113.21, "tp": "mountain", "dy": "唐", "ds": "李通玄于此处著《新华严经论》。", "ps": ["person_009"]}, {"id": "loc_006", "n": "杭州慧因寺", "lat": 30.23, "lng": 120.13, "tp": "temple", "dy": "宋", "ds": "宋代华严中兴道场。净源法师住此弘传华严，高丽义天入宋求法于此。义天归国后送金书《华严经》三种译本供养此寺。世称'华严第一道场'。", "ps": ["person_010", "person_011"]}, {"id": "loc_007", "n": "洛阳佛授记寺", "lat": 34.68, "lng": 112.44, "tp": "temple", "dy": "唐", "ds": "实叉难陀于此处主持《八十华严》译场。法藏参与证义。", "ps": ["person_003", "person_007"]}, {"id": "loc_008", "n": "台北华严莲社", "lat": 25.033, "lng": 121.565, "tp": "temple", "dy": "当代", "ds": "现代华严宗弘传中心。南亭法师创立，成一法师、贤度法师相继住持。出版华严典籍、主办国际华严学术研讨。", "ps": ["person_015", "person_016", "person_017"]}, {"id": "loc_009", "n": "北京广济寺", "lat": 39.923, "lng": 116.365, "tp": "temple", "dy": "近现代", "ds": "近代华严弘扬重要道场。慈舟法师曾长期于此讲说华严。", "ps": ["person_014"]}, {"id": "loc_010", "n": "常熟兴福寺", "lat": 31.65, "lng": 120.74, "tp": "temple", "dy": "清", "ds": "月霞长老于此处创立华严大学（1914年），开启近现代华严教育之先河。", "ps": ["person_012"]}, {"id": "loc_011", "n": "印度那烂陀寺", "lat": 25.1355, "lng": 85.4432, "tp": "temple", "dy": null, "ds": "古印度佛教最高学府。《华严经》中善财童子参访的南方诸城中，多参考此地的学术格局。", "ps": []}, {"id": "loc_012", "n": "于阗", "lat": 37.11, "lng": 79.91, "tp": "region", "dy": "唐", "ds": "古于阗国。藏译《华严经》译自于阗原本。实叉难陀故乡。中亚佛教枢纽，华严经流布关键节点。", "ps": ["person_007"]}, {"id": "loc_013", "n": "敦煌", "lat": 40.04, "lng": 94.8, "tp": "region", "dy": "唐", "ds": "敦煌藏经洞出土华严经写本数百件，包括汉文写本与藏文残片，为版本对勘提供重要实物文献。", "ps": []}, {"id": "loc_014", "n": "尼泊尔加德满都谷地", "lat": 27.71, "lng": 85.32, "tp": "region", "dy": null, "ds": "现存华严经梵文写本的主要发现地。尼泊尔梵文残卷为华严经源流研究提供了第一手文献。", "ps": []}, {"id": "loc_015", "n": "匡山（庐山）", "lat": 29.57, "lng": 115.98, "tp": "mountain", "dy": "唐", "ds": "历代华严行者修行道场之一。", "ps": []}, {"id": "l_nara", "n": "奈良东大寺", "lat": 34.69, "lng": 135.84, "tp": "temple", "dy": "唐/日本", "ds": "日本华严宗本山。审祥首次讲说《华严经》之处。", "ps": ["person_050", "person_j01", "person_j02"]}, {"id": "l_h", "n": "南投大华严寺", "lat": 23.92, "lng": 120.88, "tp": "temple", "dy": "当代", "ds": "海云继梦导师。普贤乘根本道场。", "ps": ["person_042"]}, {"id": "l_f", "n": "台北福慧寺", "lat": 24.98, "lng": 121.42, "tp": "temple", "dy": "当代", "ds": "钦因长老住持。", "ps": ["person_041", "person_043"]}], "lineage_colors": {"华严五祖": "#b8863c", "华严莲社": "#5e8b9e", "月霞系": "#7a9ec0", "李通玄系": "#c8893e", "高丽华严": "#6d9a6e", "日本华严": "#8b7a9e", "贤首宗高原法系": "#c46b5d", "临济宗": "#d48476", "慈舟系": "#8b7a9e", "译师": "#a09080", "印度源流": "#9e8b6e", "当代学者": "#b0a898", "null": "#b0a898"}}